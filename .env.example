# Docker Compose configuration (copy to .env). Secrets belong here or in your platform's secret store.
APP_URL=http://localhost:3000
COOKIE_SECURE=false            # true behind HTTPS (required in production)

POSTGRES_USER=karban
POSTGRES_PASSWORD=change-me
POSTGRES_DB=karban

MINIO_ROOT_USER=karban
MINIO_ROOT_PASSWORD=change-me-minio-secret
S3_BUCKET=karban-attachments

# Initial administrator (created by `docker compose run --rm seed`). Leave the password empty
# to get a generated temporary one printed once.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
SEED_ADMIN_EMAIL=

# E-mail (defaults to the bundled Mailpit catcher)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Karban <no-reply@karban.local>

# Telegram bot (optional): disabled | webhook | polling
TELEGRAM_MODE=disabled
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# AI provider (optional): disabled | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

SENTRY_DSN=
