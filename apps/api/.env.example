# Local development (copy to apps/api/.env). See src/config/config.ts for every option.
DATABASE_URL=postgresql://karban:karban@localhost:5432/karban?schema=public
REDIS_URL=redis://localhost:6379
# inline = run jobs inside the API process (no Redis/worker needed for development)
QUEUE_DRIVER=inline
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Tehran
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@1405
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
